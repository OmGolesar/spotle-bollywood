# Public — safe to ship to the client bundle. Anon key cannot read
# daily_puzzles.movie_id (RLS enforced; see supabase/migrations/0002_rls.sql).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NEVER expose to the client. Used by /api/* routes only.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of emails allowed to sign in to /admin.
# Example: SPOTLE_ADMIN_EMAILS=you@example.com,other@example.com
SPOTLE_ADMIN_EMAILS=

# Optional — for the content-pipeline scripts (not required to run the app).
TMDB_API_KEY=
